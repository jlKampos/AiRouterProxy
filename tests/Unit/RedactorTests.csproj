<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RedactorTests</RootNamespace>
    <AssemblyName>RedactorTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests the proxy's real sources (in isolation, without compiling the whole app). -->
    <Compile Include="..\..\src\AiRouterProxy\Detection\SecretRedactor.cs" Link="SecretRedactor.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Detection\DetectionFingerprint.cs" Link="Detection\DetectionFingerprint.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Observability\DetectionStore.cs" Link="Observability\DetectionStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Observability\RedactionNotice.cs" Link="Observability\RedactionNotice.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Observability\NoticeInjector.cs" Link="NoticeInjector.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\RouteResolver.cs" Link="RouteResolver.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\ProxyOptions.cs" Link="ProxyOptions.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\RouteHeaders.cs" Link="Routing\RouteHeaders.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Policies\InspectionPolicy.cs" Link="InspectionPolicy.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Detection\SecretDetector.cs" Link="SecretDetector.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\ConfigPaths.cs" Link="ConfigPaths.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Detection\SecurityHelpers.cs" Link="SecurityHelpers.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Policies\AuthenticationPolicy.cs" Link="AuthenticationPolicy.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Policies\RateLimiter.cs" Link="RateLimiter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseEvent.cs" Link="SseEvent.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseParser.cs" Link="SseParser.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\SseEventKind.cs" Link="SseProtocol\SseEventKind.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\ISseProtocolAdapter.cs" Link="SseProtocol\ISseProtocolAdapter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\SseProtocolJson.cs" Link="SseProtocol\SseProtocolJson.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\SseProtocolAdapterBase.cs" Link="SseProtocol\SseProtocolAdapterBase.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\SseProtocolRegistry.cs" Link="SseProtocol\SseProtocolRegistry.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\OpenAiChatAdapter.cs" Link="SseProtocol\OpenAiChatAdapter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\OpenAiResponsesAdapter.cs" Link="SseProtocol\OpenAiResponsesAdapter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\AnthropicAdapter.cs" Link="SseProtocol\AnthropicAdapter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseProtocol\GenericSseAdapter.cs" Link="SseProtocol\GenericSseAdapter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseStreamProcessor.cs" Link="SseStreamProcessor.cs" />
    <!-- Transport/Endpoint Attestation (Phase 1): stores, policy resolution, manual
         TLS connect + the client factory. BaselineStore needs DashboardPaths +
         AtomicJsonWriter, linked here too. -->
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportModels.cs" Link="Transport\TransportModels.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportStore.cs" Link="Transport\TransportStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\BaselineStore.cs" Link="Transport\BaselineStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportPolicyProvider.cs" Link="Transport\TransportPolicyProvider.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\ConnectTelemetry.cs" Link="Transport\ConnectTelemetry.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportClientFactory.cs" Link="Transport\TransportClientFactory.cs" />
    <!-- Transport/Endpoint Attestation (Phase 2): pinning + drift - pure logic, the
         shared recording pipeline, the durable learned-pin store and the probe. -->
    <Compile Include="..\..\src\AiRouterProxy\Transport\PinValidator.cs" Link="Transport\PinValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\DriftEvaluator.cs" Link="Transport\DriftEvaluator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\DriftStore.cs" Link="Transport\DriftStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\EnforcePolicy.cs" Link="Transport\EnforcePolicy.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportErrorMapper.cs" Link="Transport\TransportErrorMapper.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\LearnedPinStore.cs" Link="Transport\LearnedPinStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportCapture.cs" Link="Transport\TransportCapture.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttestationRecorder.cs" Link="Transport\AttestationRecorder.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\EndpointProbe.cs" Link="Transport\EndpointProbe.cs" />
    <!-- Phase 3 (provider blocklist + attribution): pure, no new dependencies. -->
    <Compile Include="..\..\src\AiRouterProxy\Transport\ProviderBlocklist.cs" Link="Transport\ProviderBlocklist.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\ProviderBodyPolicy.cs" Link="Transport\ProviderBodyPolicy.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttributionExtractor.cs" Link="Transport\AttributionExtractor.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttributionStore.cs" Link="Transport\AttributionStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttestationOrigin.cs" Link="Transport\AttestationOrigin.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\ProviderFeedValidator.cs" Link="AdminValidation\ProviderFeedValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\AdminPaths.cs" Link="AdminPersistence\AdminPaths.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\AtomicJsonWriter.cs" Link="AdminPersistence\AtomicJsonWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- TransportPolicyProvider uses IOptionsMonitor and the TLS path uses
         SslClientAuthenticationOptions/SocketsHttpHandler: the ASP.NET Core shared
         framework provides them (same pattern as Dashboard.Tests). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
