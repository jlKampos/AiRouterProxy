<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DashboardTests</RootNamespace>
    <AssemblyName>DashboardTests</AssemblyName>
    <!-- DashboardAdminService uses EventLog (Windows-only); same suppression as the host. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host gets Microsoft.AspNetCore.Http from the Web SDK's implicit usings; this
         console harness links the middleware source, so add the same global using. -->
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests the dashboard write-phase sources in isolation (validators, persistence,
         services, shared contracts). No Blazor, no host, no real config files. -->
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\RouteValidator.cs" Link="AdminValidation\RouteValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\KeyValidator.cs" Link="AdminValidation\KeyValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\SecurityValidator.cs" Link="AdminValidation\SecurityValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\ImportValidator.cs" Link="AdminValidation\ImportValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\RouteDraftJson.cs" Link="AdminValidation\RouteDraftJson.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\AdminPaths.cs" Link="AdminPersistence\AdminPaths.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\AtomicJsonWriter.cs" Link="AdminPersistence\AtomicJsonWriter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\ConfigFileReader.cs" Link="AdminPersistence\ConfigFileReader.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\ConfigBackup.cs" Link="AdminPersistence\ConfigBackup.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\ReloadConfirmer.cs" Link="AdminPersistence\ReloadConfirmer.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\KeyMetaStore.cs" Link="AdminPersistence\KeyMetaStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminPersistence\AuditLog.cs" Link="AdminPersistence\AuditLog.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Observability\ActivityStore.cs" Link="Observability\ActivityStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Observability\DetectionStore.cs" Link="Observability\DetectionStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Observability\IEventLogStore.cs" Link="Observability\IEventLogStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminServices\AdminHash.cs" Link="AdminServices\AdminHash.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminServices\DashboardAdminService.cs" Link="AdminServices\DashboardAdminService.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\ProxyOptions.cs" Link="Routing\ProxyOptions.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\ConfigPaths.cs" Link="Routing\ConfigPaths.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Routing\RouteResolver.cs" Link="Routing\RouteResolver.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Policies\AuthenticationPolicy.cs" Link="Policies\AuthenticationPolicy.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Policies\RateLimiter.cs" Link="Policies\RateLimiter.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminUi\UiSessionMiddleware.cs" Link="AdminUi\UiSessionMiddleware.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Detection\SecurityHelpers.cs" Link="Detection\SecurityHelpers.cs" />
    <!-- Detection forensics round-trip: DetectionRecord -> DetectionEntry -> DetectionView. -->
    <Compile Include="..\..\src\AiRouterProxy\Detection\SecretDetector.cs" Link="Detection\SecretDetector.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Detection\SecretRedactor.cs" Link="Detection\SecretRedactor.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Detection\DetectionFingerprint.cs" Link="Detection\DetectionFingerprint.cs" />
    <Compile Include="..\..\src\AiRouterProxy.Dashboard\Models\DashboardModels.cs" Link="Models\DashboardModels.cs" />
    <Compile Include="..\..\src\AiRouterProxy.Dashboard\Models\IDashboardAdminService.cs" Link="Models\IDashboardAdminService.cs" />
    <!-- Real host facade: the security round-trip test asserts the view the UI reads. -->
    <Compile Include="..\..\src\AiRouterProxy\AdminUi\HostDashboardFacade.cs" Link="AdminUi\HostDashboardFacade.cs" />
    <!-- Transport/Endpoint attestation types used by the host facade (GetAttestation). -->
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportModels.cs" Link="Transport\TransportModels.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportStore.cs" Link="Transport\TransportStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\BaselineStore.cs" Link="Transport\BaselineStore.cs" />
    <!-- Transport/Endpoint attestation (Phase 2): policy provider + pinning/drift chain,
         the shared recorder and the probe (all reachable from the admin service/facade). -->
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportPolicyProvider.cs" Link="Transport\TransportPolicyProvider.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\PinValidator.cs" Link="Transport\PinValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\DriftEvaluator.cs" Link="Transport\DriftEvaluator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\DriftStore.cs" Link="Transport\DriftStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\EnforcePolicy.cs" Link="Transport\EnforcePolicy.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\LearnedPinStore.cs" Link="Transport\LearnedPinStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\TransportCapture.cs" Link="Transport\TransportCapture.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttestationRecorder.cs" Link="Transport\AttestationRecorder.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\EndpointProbe.cs" Link="Transport\EndpointProbe.cs" />
    <!-- Phase 3: provider feed validation + draft conversions, and the origin-read
         helpers the admin service calls (providers.json write + aggregator origin). -->
    <Compile Include="..\..\src\AiRouterProxy\Transport\ProviderBlocklist.cs" Link="Transport\ProviderBlocklist.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttestationOrigin.cs" Link="Transport\AttestationOrigin.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttributionStore.cs" Link="Transport\AttributionStore.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Transport\AttributionExtractor.cs" Link="Transport\AttributionExtractor.cs" />
    <!-- AttributionExtractor's SSE overloads parse raw chunks with the core Sse parser
         (self-contained - no SseProtocol adapters needed by the dashboard harness). -->
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseEvent.cs" Link="Sse\SseEvent.cs" />
    <Compile Include="..\..\src\AiRouterProxy\Sse\SseParser.cs" Link="Sse\SseParser.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\ProviderFeedValidator.cs" Link="AdminValidation\ProviderFeedValidator.cs" />
    <Compile Include="..\..\src\AiRouterProxy\AdminValidation\ProviderEntryDraftJson.cs" Link="AdminValidation\ProviderEntryDraftJson.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- UiSessionMiddleware.cs (linked above) uses HttpContext/CookieOptions/StatusCodes and
         the harness uses IOptionsMonitor/ILogger/EventLog: the ASP.NET Core shared framework
         already provides all of them (the explicit PackageReferences would only raise NU1510). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
