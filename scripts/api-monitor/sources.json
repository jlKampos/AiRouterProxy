      "name": "anthropic-release-notes",
      "provider": "anthropic",
      "url": "https://docs.claude.com/en/release-notes/api.md",
      "kind": "markdown",
      "watch": [
        { "pattern": "content_block|tool_use|thinking|reasoning|\\bstream\\b|SSE|message_start|message_delta|input_json_delta", "area": "SSE protocol adapters (SseProtocol/)" },
        { "pattern": "anthropic-version|ratelimit|rate.?limit|request-id|anthropic-organization-id|Retry-After", "area": "Response headers forwarding" },
        { "pattern": "request size|maximum request|128 MB|32 MB|max_body|maxBodySize|payload", "area": "Body size limits (MaxBodySize)" },
        { "pattern": "system prompt|tool result|content type|application/json|multipart", "area": "Request inspection / redaction" },
        { "pattern": "429|503|400|401|error code|slow_down|server_is_overloaded|lockout|backoff", "area": "Rate limiting / error mapping" },
        { "pattern": "deprecat|breaking|migrat|remov|retired|shut down|endpoint|beta header", "area": "Route config / auth" }
      ]
    },
