<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AIRouterProxy</RootNamespace>
    <AssemblyName>AIRouterProxy</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Version>2.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- All editable config goes to a "config" subfolder of the deploy, so the deploy
         root only has the executable and the config files are easy to find. The server
         reads from config/ when it exists (ConfigPaths) and falls back to the exe
         folder otherwise (dev/legacy installs stay compatible).
         Unversioned TLS certs: they live in the server deploy, not in the repo. -->
    <None Include="proxy-cert.pem" Condition="Exists('proxy-cert.pem')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="config\proxy-cert.pem" />
    <None Include="proxy-key.pem" Condition="Exists('proxy-key.pem')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="config\proxy-key.pem" />
    <!-- Non-secret config (redaction/routes) - no keys, preserved by deploy-update.ps1.
         Source files live in Config/ in the repo; they all land in config/ at deploy. -->
    <Content Update="Config\redaction.json" Condition="Exists('Config\redaction.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>config\redaction.json</TargetPath>
    </Content>
    <Content Update="Config\routes.json" Condition="Exists('Config\routes.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>config\routes.json</TargetPath>
    </Content>
    <!-- Default app config + dev overrides + server template all land in config/. -->
    <Content Update="Config\appsettings.json" Condition="Exists('Config\appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>config\appsettings.json</TargetPath>
    </Content>
    <Content Update="Config\appsettings.Development.json" Condition="Exists('Config\appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>config\appsettings.Development.json</TargetPath>
    </Content>
    <Content Update="Config\appsettings.Server.example.json" Condition="Exists('Config\appsettings.Server.example.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>config\appsettings.Server.example.json</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The server keys config: never published (lives only on the target machine). -->
    <Content Remove="appsettings.Server.json" />
    <Content Include="appsettings.Server.json" Condition="Exists('appsettings.Server.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <TargetPath>config\appsettings.Server.json</TargetPath>
    </Content>
  </ItemGroup>

</Project>