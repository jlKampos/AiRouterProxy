{
  "Proxy": {
    "Redaction": {
      "enabled": true,
      "mask": "••••••",
      "notifyInResponse": true,
      "warnTemplate": "",
      "detect": {
        "byFieldName": true,
        "byFormats": true,
        "byKeyValueContext": true,
        "byLongStrings": true,
        "exemptBase64": true,
        "entropyThreshold": 3.0
      },
      "allow": [
        "^ACME-[0-9]{3,5}-"
      ]
    },
    "Inspection": {
      "enabled": true,
      "defaultAction": "block",
      "invalidJson": "block",
      "byContentType": {
        "application/json": "inspect",
        "application/xml": "block",
        "application/octet-stream": "block",
        "multipart/form-data": "block",
        "application/x-www-form-urlencoded": "block"
      }
    },
    "RateLimit": {
      "enabled": true,
      "maxRequestsPerWindow": 120,
      "requestWindowSeconds": 60,
      "maxFailuresPerWindow": 10,
      "failureWindowSeconds": 300,
      "lockoutSeconds": 300
    }
  }
}
