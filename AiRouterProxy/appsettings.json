{
  "Proxy": {
    "Host": "0.0.0.0",
    "Port": 4000,
    "Upstream": "https://api.airrouter.ch",
    "AllowedPaths": [
      "/v1/models",
      "/v1/chat/completions",
      "/v1/completions",
      "/v1/embeddings",
      "/v1/audio/transcriptions",
      "/v1/audio/speech",
      "/v1/audio/voices"
    ],
    "RequestTimeoutMs": 300000,
    "MaxBodySize": 20971520,
    "Verbose": true,
    "Cert": {
      "PemCert": "proxy-cert.pem",
      "PemKey": "proxy-key.pem"
    },
    "Redaction": {
      "enabled": true,
      "notifyInResponse": true,
      "detect": {
        "byFieldName": true,
        "byFormats": true,
        "byKeyValueContext": true,
        "byLongStrings": true
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  }
}
